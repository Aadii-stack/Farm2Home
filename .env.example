# Farm2Home - Environment Configuration
# Copy this file to .env to connect to your live Supabase project.
# If these variables are left empty, the application runs in interactive Demo Mode
# with in-browser transactional database and authentic Mira Bhayandar sample data.

# Supabase URL (From Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public API Key (From Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
